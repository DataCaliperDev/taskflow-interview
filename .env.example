# Example environment configuration for TaskFlow.
#
# Copy to `.env` and adjust as needed:  cp .env.example .env
# Every key below is OPTIONAL — if unset, the defaults in app/config.py are used,
# so the application runs unchanged without any `.env` file present.
# `.env` itself is gitignored; never commit real secrets.

# --- Application ---
APP_NAME=TaskFlow
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./taskflow.db

# --- Security ---
# Generate a strong secret, e.g.:  openssl rand -hex 32
SECRET_KEY=replace-with-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Pagination ---
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
