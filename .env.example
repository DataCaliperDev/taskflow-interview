# Copy to .env and fill in real values:  cp .env.example .env
# Real environment variables override values in .env.

# REQUIRED — signs JWT access tokens. Must be at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database connection string (defaults to a local SQLite file).
# For Postgres:  postgresql+psycopg://user:password@host:5432/taskflow
DATABASE_URL=sqlite:///./taskflow.db

# Optional
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false
